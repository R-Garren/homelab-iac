# ══════════════════════════════════════════════════════════════════════════════
# /opt/homelab/lab/.env.example
#
# Copy to .env and fill in values before running 'docker compose up -d'
#   cp .env.example .env && nano .env
#
# These credentials are for the DVWA database only — internal to Docker.
# The database port is not exposed outside the lab network, so these passwords
# don't need to be cryptographically strong, but don't reuse passwords from
# your actual systems.
# ══════════════════════════════════════════════════════════════════════════════

# MariaDB root password (used by MariaDB internals, not needed day-to-day)
DVWA_DB_ROOT_PASSWORD=change_this_root_password

# DVWA application database password (used by DVWA to connect to dvwa-db)
DVWA_DB_PASSWORD=change_this_dvwa_password
