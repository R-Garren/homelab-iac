<group name="pihole,dns,">

  <!-- Base: every decoded Pi-hole event. Level 2 = countable, not alerted. -->
  <rule id="100100" level="2">
    <decoded_as>pihole</decoded_as>
    <description>Pi-hole: DNS event.</description>
  </rule>

  <!-- Blocked domain. ~36k/day - never alert individually. -->
  <rule id="100101" level="2">
    <if_sid>100100</if_sid>
    <field name="dns_answer" type="pcre2">^(0\.0\.0\.0|::|NODATA|NXDOMAIN)$</field>
    <description>Pi-hole: domain blocked ($(dns_query_name)).</description>
  </rule>

  <!-- Volume spike: ~8x the observed 25/min baseline. -->
  <rule id="100102" level="5" frequency="200" timeframe="60">
    <if_matched_sid>100101</if_matched_sid>
    <description>Pi-hole: unusually high volume of blocked DNS queries - possible infected or misbehaving device.</description>
  </rule>

  <!-- Long hex label: DNS tunneling / exfiltration indicator. -->
  <rule id="100110" level="8">
    <if_sid>100100</if_sid>
    <field name="dns_query_name" type="pcre2">^[A-Fa-f0-9]{32,}\.</field>
    <description>Pi-hole: DNS query with long hexadecimal label - possible DNS tunneling ($(dns_query_name)).</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
  </rule>

  <!-- Tuning: Amazon device telemetry uses long hex labels legitimately.
       Confirmed benign 2026-08-29 - minerva.devices.a2z.com is Amazon
       device service traffic, not exfiltration. -->
  <rule id="100111" level="0">
    <if_sid>100110</if_sid>
    <field name="dns_query_name" type="pcre2">\.a2z\.com$</field>
    <description>Pi-hole: Amazon device telemetry - known-good long-label DNS (tuned out).</description>
  </rule>

  <!-- NXDOMAIN tracking. -->
  <rule id="100120" level="2">
    <if_sid>100100</if_sid>
    <match>is NXDOMAIN</match>
    <description>Pi-hole: NXDOMAIN response.</description>
  </rule>

  <!-- Tuning: mDNS/local service discovery generates constant NXDOMAIN. -->
  <rule id="100122" level="0">
    <if_sid>100120</if_sid>
    <regex type="pcre2">\.(lan|local|arpa|internal) is NXDOMAIN</regex>
    <description>Pi-hole: NXDOMAIN for local domain (expected mDNS/service discovery).</description>
  </rule>

  <!-- NXDOMAIN burst on external domains: DGA indicator. -->
  <rule id="100121" level="6" frequency="30" timeframe="60">
    <if_matched_sid>100120</if_matched_sid>
    <description>Pi-hole: high volume of external NXDOMAIN responses - possible DGA malware.</description>
    <mitre>
      <id>T1568.002</id>
    </mitre>
  </rule>

</group>
